{
  "name": "sentinela",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinela-db",
      "database_id": "cff329df-c19e-4fcf-a154-8f8512884eb7",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "fae20869fa1341efa44c41c72b037961"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "30 13 * * 1-5",
      "30 0 * * 2-6"
    ]
  }
}
